# Copia este archivo a .env.local y llena los valores. Son IDs públicos
# (no son secretos), pero de todos modos .env* está en .gitignore.

# Google Cloud Console > APIs & Services > Credentials > Create Credentials
# > OAuth client ID > tipo "Web application"
# Authorized JavaScript origins: agrega http://localhost:5173 y tu dominio de producción
VITE_GOOGLE_CLIENT_ID=

# Azure AD (Microsoft Entra ID) > App registrations > New registration
# Platform: "Single-page application", Redirect URI: http://localhost:5173 y tu dominio de producción
# API permissions (delegated, Microsoft Graph): Calendars.Read
VITE_MS_CLIENT_ID=
# 'common' si es cuenta personal o multi-tenant; o el Tenant ID si tu organización lo exige
VITE_MS_TENANT=common
